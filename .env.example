# Lineup Card vendor settings. Names only: leave the values empty here.
# Set the real values as environment variables (or in the macOS Keychain, see
# README "Run it every morning"). Never put keys in a file in this folder.

# VALD (keys from support@vald.com after the API License Agreement)
VALD_CLIENT_ID=
VALD_CLIENT_SECRET=
VALD_TENANT_ID=
# use (United States East), aue (Australia East) or euw (Europe West)
VALD_REGION=
# Optional. Test type code for the countermovement jump. Default: CMJ
VALD_CMJ_TEST_TYPE=
# Optional. Result name, idString or id. Several choices separated by |
# Defaults: "Jump Height (Imp-Mom)" and "RSI-modified|RSI_MODIFIED"
VALD_JUMP_RESULT=
VALD_RSI_RESULT=

# Catapult OpenField Cloud (API token, enabled per account by Catapult)
CATAPULT_TOKEN=
# us, eu, apac, or a full *.catapultsports.com host name (https, no path or port)
CATAPULT_HOST=
# Optional. Parameter slugs. Load default: total_player_load.
# Throw and pitch slugs are account specific; blank columns until set.
CATAPULT_LOAD_SLUG=
CATAPULT_THROW_SLUG=
CATAPULT_PITCH_SLUG=

# Optional. The whole pull stops after this many seconds. Default: 900 (15 minutes)
LINEUP_PULL_BUDGET_S=
